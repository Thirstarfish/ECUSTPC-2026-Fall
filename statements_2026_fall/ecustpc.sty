% --- 题目彩色标签 (tcolorbox) ---
% 使用循环或通用宏简化定义
\newcommand{\contestbox}[2]{%
  \newtcbox{#1}{on line, arc = 0pt, outer arc = 1pt,
    colback = #2, colframe = #2,
    boxsep = 0pt, left = 3pt, right = 3pt, top = 3pt, bottom = 3pt,
    boxrule = 0pt, bottomrule = 1pt, toprule = 1pt, leftrule = 1pt, rightrule = 1pt}
}
\newcommand{\contestboxwhite}[2]{% % 文字为白色的版本
  \newtcbox{#1}{on line, arc = 0pt, outer arc = 1pt,
    colback = #2, colframe = #2, coltext=white,
    boxsep = 0pt, left = 3pt, right = 3pt, top = 3pt, bottom = 3pt,
    boxrule = 0pt, bottomrule = 1pt, toprule = 1pt, leftrule = 1pt, rightrule = 1pt}
}

\contestboxwhite{\myboxi}{Line1}   \contestboxwhite{\myboxii}{Line2}  \contestbox{\myboxiii}{Line3}
\contestboxwhite{\myboxiv}{Line4}  \contestbox{\myboxv}{Line5}   \contestboxwhite{\myboxvi}{Line6}
\contestbox{\myboxvii}{Line7} \contestboxwhite{\myboxviii}{Line8} \contestbox{\myboxix}{Line9}
\contestboxwhite{\myboxx}{Line10}  \contestbox{\myboxxi}{Line11} \contestboxwhite{\myboxxii}{Line12}
\contestbox{\myboxxiii}{Line13}


% --- 代码样式配置 ---
\definecolor{mygreen}{RGB}{34,139,34}
\definecolor{mygray}{rgb}{0.5,0.5,0.5}
\definecolor{myred}{RGB}{178,34,34}

\lstset{
    tabsize = 2,
    basicstyle = \small\ttfamily, 
    columns=fullflexible,       
    numbers=none,
    frame=l,
    breaklines=true, 
    backgroundcolor=\color{white},
    keywordstyle=\color{mygreen},
    commentstyle=\color{mygray},
    stringstyle=\color{myred}\ttfamily,
    showstringspaces=false,
    language=c++,
    xleftmargin=0.5cm,
}

% --- 章节格式 ---
\renewcommand{\thesection}{试题 \hspace{-0.5em}}
\renewcommand{\thesubsection}{\hspace{-1em}}

% --- 刻意留白页 ---
\newcommand{\intentionalblankpage}{%
  \clearpage\null\vfill
  \begin{center}{\large 此页为保证阅读顺畅，刻意留白}\end{center}
  \vfill\clearpage
}

% --- 页眉页脚设置宏 ---
\newcommand{\setcontestheader}[2]{
  \fancyhf{}
  \fancyfoot[C]{\bfseries{第 \thepage 页 \quad 共 \pageref{LastPage} 页}}
  \fancyhead[C]{\textsf{#1 \\ #2}}
  \renewcommand{\headrulewidth}{0.4pt}
}

